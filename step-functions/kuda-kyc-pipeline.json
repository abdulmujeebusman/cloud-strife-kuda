{
    "Comment": "Cloud Strife — Kuda Bank KYC Pipeline. Lambda ARN placeholders are filled in by Terraform (infra/terraform).",
    "StartAt": "ValidateUploads",
    "States": {
        "ValidateUploads": {
            "Type": "Task",
            "Resource": "${validate_uploads_arn}",
            "Next": "CompareFaces",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": ["KYCDocumentsMissing"],
                    "Next": "UploadError"
                },
                {
                    "ErrorEquals": ["States.ALL"],
                    "Next": "ProcessingError"
                }
            ]
        },
        "CompareFaces": {
            "Type": "Task",
            "Resource": "${compare_faces_arn}",
            "Next": "KYCDecision",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": ["States.ALL"],
                    "Next": "ProcessingError"
                }
            ]
        },
        "KYCDecision": {
            "Type": "Choice",
            "Comment": "The similarity threshold is applied once, in kyc_compare_faces; this state only reads the result.",
            "Choices": [
                {
                    "Variable": "$.faceMatch",
                    "BooleanEquals": true,
                    "Next": "ApproveKYC"
                }
            ],
            "Default": "FlagIdentityMismatch"
        },
        "ApproveKYC": {
            "Type": "Task",
            "Resource": "${update_status_arn}",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "End": true
        },
        "FlagIdentityMismatch": {
            "Type": "Task",
            "Resource": "${update_status_arn}",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "End": true
        },
        "UploadError": {
            "Type": "Fail",
            "Error": "KYCDocumentsMissing",
            "Cause": "Uploads missing in S3"
        },
        "ProcessingError": {
            "Type": "Fail",
            "Error": "KYCProcessingError",
            "Cause": "Unexpected error while validating uploads or comparing faces"
        }
    }
}
